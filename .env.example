APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8030

# Restricted Signals Platform interface
SIGNALS_PLATFORM_BASE_URL=https://example.invalid
SIGNALS_PLATFORM_API_TOKEN=replace_with_restricted_token

# Google Cloud / Gemini
GOOGLE_CLOUD_PROJECT=replace_with_project_id
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GEMINI_MODEL=replace_with_supported_model

# Grafana
GRAFANA_URL=https://example.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=replace_with_restricted_token
GRAFANA_MCP_URL=replace_with_mcp_endpoint

# Demo mode must never contain production evidence
DEMO_MODE=true

# Restricted mock API authentication
RESTRICTED_API_TOKEN=replace_with_long_random_demo_token
